{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RavenVault Desktop",
  "version": "0.4.5",
  "identifier": "se.erci.ex.playx.raven",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RavenVault Desktop",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://127.0.0.1:8080 http://127.0.0.1:8790",
        "media-src": "'self' data: blob: https: http://127.0.0.1:8080 http://127.0.0.1:8790",
        "font-src": "'self' data:",
        "frame-src": "https://www.youtube.com https://player.vimeo.com http://127.0.0.1:8080 http://127.0.0.1:8790",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: ws://localhost:1420 https://rvn.ex.erci.se",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "693df2cf-3ab4-5924-9965-a3bf71d75a61",
        "template": "installer/wix-ravenvault.wxs",
        "language": [
          "ko-KR",
          "en-US"
        ],
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      },
      "nsis": {
        "template": "installer/nsis-ravenvault.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NDExQTFGRjNEQjgyMEEKUldRS2d0dnpIeHBCMWhjYVRSMkdFSUV3VTRyeUZkZ1M0SVIySWw2MEJ6Qml2UjUxdEd3V2gyMjUK",
      "endpoints": [
        "https://rvn.ex.erci.se/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
