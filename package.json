{
  "name": "playx-raven",
  "private": true,
  "version": "0.8.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node preflight.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "preflight": "node preflight.mjs",
    "screensweep": "node screensweep.mjs",
    "countercheck": "node countercheck.mjs",
    "check:issue-gate": "node scripts/check-issue-gate.mjs",
    "check:peer-help": "node scripts/check-peer-help.mjs",
    "check:ravi-panel": "node scripts/check-ravi-panel.mjs",
    "check:ravi-promo": "node scripts/check-ravi-promo.mjs && node scripts/check-ravi-promo-card.mjs",
    "check:ravi-promo:browser": "node scripts/check-ravi-promo-browser.mjs",
    "check:ravi-panel:browser": "node scripts/check-ravi-panel-browser.mjs",
    "check:ravi-understanding": "node scripts/check-ravi-understanding.mjs",
    "check:ravi-understanding:browser": "node scripts/check-ravi-understanding-browser.mjs",
    "check:firstrun": "node scripts/check-firstrun.mjs",
    "check:pre-release": "npm run build && node scripts/check-firstrun.mjs && npm run check:ravi-companion && npm run check:home-onescreen",
    "check:ravi-companion": "node scripts/check-ravi-companion.mjs && node scripts/check-companion-fix.mjs",
    "check:home-onescreen": "node scripts/check-home-onescreen.mjs",
    "typecheck": "tsc --noEmit",
    "test:mini": "node --test scripts/mini-window.test.mjs scripts/mini-window-browser.test.mjs",
    "test:modes": "node --test scripts/window-modes.test.mjs scripts/window-modes-browser.test.mjs",
    "test:layout": "node --test scripts/layout-gate-browser.test.mjs",
    "audit:design": "node scripts/design-audit-browser.mjs",
    "check:mini-regtest": "node scripts/mini-regtest-latency.mjs",
    "test": "node --test scripts/opening.test.mjs scripts/sales-account.test.mjs scripts/release-manifest.test.mjs scripts/verify-published-release.test.mjs scripts/signed-release-metadata.test.mjs scripts/desktop-ui-browser.test.mjs scripts/creator-publish.test.mjs scripts/creator-publish-browser.test.mjs scripts/name-lookup.test.mjs scripts/signed-lists-browser.test.mjs scripts/memory-budget-browser.test.mjs scripts/drop-publish.test.mjs scripts/drop-publish-browser.test.mjs scripts/window-modes.test.mjs scripts/window-modes-browser.test.mjs scripts/layout-gate-browser.test.mjs",
    "test:memory": "node --test scripts/memory-budget-browser.test.mjs",
    "measure:memory": "node scripts/measure-memory.mjs",
    "check:ravi-emotion": "node --test --test-concurrency=1 scripts/ravi-emotion.test.mjs scripts/ravi-emotion-gallery.mjs scripts/ravi-emotion-app-browser.test.mjs",
    "gallery:drop": "RV_DROP_SHOTS=artifacts/drop-gallery/shots node --test scripts/drop-publish-browser.test.mjs && node scripts/build-drop-gallery.mjs",
    "check:home-browser": "npm run build && node scripts/check-home-browser.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@ravenrebels/ravencoin-key": "^3.0.5",
    "@ravenrebels/ravencoin-sign-transaction": "^1.1.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "jsqr": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@scure/bip32": "2.4.0",
    "@noble/hashes": "1.8.0",
    "@noble/curves": "1.9.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "puppeteer-core": "^23.11.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
